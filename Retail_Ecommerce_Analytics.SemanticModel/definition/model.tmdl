model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Dim_Store","Dim_Product","Dim_Customer","Dim_Promotion","Fact_Inventory","Fact_Sales"]

ref table Dim_Date
ref table _Measures
ref table Dim_Store
ref table Dim_Product
ref table Dim_Customer
ref table Dim_Promotion
ref table Fact_Inventory
ref table Fact_Sales

ref cultureInfo en-US

