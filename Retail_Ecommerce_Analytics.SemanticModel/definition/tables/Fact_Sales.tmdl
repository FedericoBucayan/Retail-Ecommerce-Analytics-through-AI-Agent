				        {"unit_price", type number},
				        {"total_value", type number},
				        {"channel", type text},
				        {"discount_pct", type number}
				    }, "en-US"),
				    #"Added Net Amount" = Table.AddColumn(#"Changed Type", "net_amount", each [total_value] * (1 - [discount_pct] / 100), type number)
				in
